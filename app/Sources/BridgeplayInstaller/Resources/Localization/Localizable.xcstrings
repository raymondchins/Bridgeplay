    "Close Bridgeplay before updating. Steam setup and any required permissions are handled by Bridgeplay after installation." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi Bridgeplay prima di aggiornare. Dopo l'installazione, Bridgeplay configurerà Steam e richiederà le autorizzazioni necessarie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте Bridgeplay перед обновлением. Настройку Steam и нужные разрешения Bridgeplay обработает после установки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新前请先退出 Bridgeplay。安装后，Bridgeplay 会配置 Steam 并请求所需权限。"
