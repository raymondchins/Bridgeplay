    },
    "The application could not be replaced. Check the app and its previous-version backup in Applications before trying again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The application could not be replaced. Check the app and its previous-version backup in Applications before trying again."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile sostituire l’applicazione. Controlla l’app e il backup della versione precedente in Applicazioni prima di riprovare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось заменить приложение. Проверьте приложение и резервную копию предыдущей версии в «Программах» и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法替换应用。请在“应用程序”中检查应用及其旧版本备份后重试。"
          }
        }
      }
    },
    "The application goes in Applications. Your settings, game prefixes and saves are kept." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'applicazione viene installata in Applicazioni. Le impostazioni, i prefissi di gioco e i salvataggi vengono mantenuti."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение устанавливается в «Программы». Ваши настройки, префиксы игр и сохранения остаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用程序将安装到“应用程序”文件夹。你的设置、游戏前缀和存档都会保留。"
          }
        }
      }
    },
    "The application location is not safe to update." : {
