    "Only the application is downloaded here. Its signature is checked before installation." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui viene scaricata solo l'applicazione. La firma viene verificata prima dell'installazione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь загружается только приложение. Его подпись проверяется перед установкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处只会下载应用程序，并在安装前验证其签名。"
          }
        }
      }
    },
    "Open Bridgeplay" : {
      "localizations" : {
