        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato, quindi Bridgeplay non può esserne rimosso. Tutti gli altri dati di Bridgeplay vengono rimossi, tranne i giochi Windows e i prefissi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接，因此无法从中移除 Bridgeplay。其他所有 Bridgeplay 数据都会被移除，但 Windows 游戏及游戏容器除外。"
          }
        }
      }
    },
    "Steam at %@ isn't connected." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接。"
          }
        }
      }
    },
    "Steam client updates are allowed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam sono consentiti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已允许 Steam 客户端更新。"
          }
        }
      }
    },
    "Steam client updates are blocked." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam sono bloccati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已阻止 Steam 客户端更新。"
          }
        }
      }
    },
    "Steam client updates may break Bridgeplay." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam potrebbero rendere Bridgeplay inutilizzabile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 客户端更新可能导致 Bridgeplay 无法使用。"
          }
        }
      }
    },
    "Steam client updates may break Bridgeplay. If you don't want to wait for Bridgeplay to be updated to be compatible with future Steam versions at the cost of not getting updates to the Steam client, you can stop the Steam client from updating itself. You also miss Steam's security fixes." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam potrebbero rendere Bridgeplay inutilizzabile. Se non vuoi aspettare che Bridgeplay venga aggiornato per le future versioni di Steam, puoi impedire al client Steam di aggiornarsi, rinunciando però ai suoi aggiornamenti. Non ricevi nemmeno le correzioni di sicurezza di Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 客户端更新可能导致 Bridgeplay 无法使用。你可以阻止 Steam 自动更新，避免等待 Bridgeplay 适配新版本，但这也意味着无法及时获得 Steam 客户端的功能改进和安全更新。你也无法获得 Steam 的安全修复。"
          }
        }
      }
    },
    "Steam closes for a moment and opens again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam si chiude per un momento e poi si riapre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 会短暂关闭，然后重新打开。"
          }
        }
      }
    },
    "Steam could not be fully restored. Please run Repair Steam again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile ripristinare completamente Steam. Esegui di nuovo Ripara Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能完全恢复 Steam。请再次执行“修复 Steam”。"
          }
        }
      }
    },
    "Steam did not quit. Choose Steam > Quit Steam, then try again. If Steam does not respond, quit it in Activity Monitor." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non si è chiuso. Scegli Steam > Esci da Steam, poi riprova. Se Steam non risponde, chiudilo da Monitoraggio Attività."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 未能退出。请选择“Steam”>“退出 Steam”，然后重试。如果 Steam 没有响应，请在“活动监视器”中退出它。"
          }
        }
      }
    },
    "Steam has a different copy of Bridgeplay, and this account cannot update it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ha una copia diversa di Bridgeplay e questo account non può aggiornarla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中有另一份 Bridgeplay，而此账户无法更新它。"
          }
        }
      }
    },
    "Steam has a different copy of Bridgeplay, installed by another account on this Mac. Update Bridgeplay from that account, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ha una copia diversa di Bridgeplay, installata da un altro account su questo Mac. Aggiorna Bridgeplay da quell'account, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中的另一份 Bridgeplay 是由本机其他账户安装的。请使用该账户更新 Bridgeplay，然后重试。"
          }
        }
      }
    },
    "Steam has a newer build" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ha una build più recente"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 有较新的版本"
          }
        }
      }
    },
    "Steam has not been set up for Bridgeplay, and this account cannot change it. Install from the account that owns Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non è stato configurato per Bridgeplay e questo account non può modificarlo. Installa dall'account a cui appartiene Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 尚未配置 Bridgeplay，当前账户无权修改。请使用安装 Steam 的账户执行安装。"
          }
        }
      }
    },
    "Steam integration needs repair." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'integrazione con Steam va riparata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 集成需要修复。"
          }
        }
      }
    },
    "Steam is modified" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato modificato"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已被修改"
          }
        }
      }
    },
    "Steam is open in another account on this Mac. Quit Steam in that account, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è aperto in un altro account su questo Mac. Chiudi Steam in quell'account, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在这台 Mac 的另一个账户中运行。请在该账户中退出 Steam，然后重试。"
          }
        }
      }
    },
    "Steam is restored to its unmodified state and Bridgeplay is removed, including the compatibility tool that lives inside the Steam folder. Windows games and Steam Play prefixes are not removed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam viene riportato allo stato originale e Bridgeplay viene rimosso, compreso lo strumento di compatibilità nella cartella di Steam. I giochi Windows e i prefissi di Steam Play non vengono rimossi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会将 Steam 恢复为未修改的状态，并移除 Bridgeplay（包括 Steam 文件夹内的兼容工具）。不会删除 Windows 游戏及 Steam Play 游戏容器。"
          }
        }
      }
    },
    "Steam is running" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è in esecuzione"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在运行"
          }
        }
      }
    },
    "Steam is running, and it rewrites its settings when it quits. Quit Steam, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è in esecuzione e riscrive le sue impostazioni quando si chiude. Chiudi Steam, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在运行，且退出时会重写其设置。请先退出 Steam，然后重试。"
          }
        }
      }
    },
    "Steam is set up to inject a different dylib. Please repair Steam before installing Bridgeplay." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è configurato per caricare una dylib diversa. Ripara Steam prima di installare Bridgeplay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已配置为注入其他动态库。请先修复 Steam，再安装 Bridgeplay。"
          }
        }
      }
    },
    "Steam not found" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non trovato"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到 Steam"
          }
        }
      }
    },
    "Steam not found." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non trovato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到 Steam。"
          }
        }
      }
    },
    "Steam opened while Bridgeplay was getting ready to update it, so Steam was left alone." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam si è aperto mentre Bridgeplay si preparava ad aggiornarlo, quindi Steam non è stato toccato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay 准备更新 Steam 时 Steam 已打开，因此未对 Steam 做任何更改。"
          }
        }
      }
    },
    "Steam restored to its original state." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam riportato allo stato originale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已恢复原状。"
          }
        }
      }
    },
    "Steam running" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in esecuzione"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在运行"
          }
        }
      }
    },
    "Steam runs every game without a tool of its own with this one. Change it in the Setup Assistant while Steam is closed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam usa questo strumento per ogni gioco che non ne ha uno proprio. Cambialo nell'Assistente di configurazione mentre Steam è chiuso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 会用此工具运行所有未单独指定工具的游戏。请在 Steam 关闭时于设置助理中更改。"
          }
        }
      }
    },
    "Steam updated" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam aggiornato"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已更新"
          }
        }
      }
    },
    "Steam updated, so Bridgeplay put itself back into Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato aggiornato, quindi Bridgeplay si è rimesso in Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已更新，Bridgeplay 已重新加入 Steam。"
          }
        }
      }
    },
    "Steam updates are blocked, security fixes included." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti di Steam sono bloccati, comprese le correzioni di sicurezza."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 更新已被阻止，包括安全修复。"
          }
        }
      }
    },
    "Steam was installed by another account on this Mac. Only that account can modify it. Log in to macOS with that account to reinstall Bridgeplay." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato installato da un altro account su questo Mac e solo quell'account può modificarlo. Accedi a macOS con quell'account per reinstallare Bridgeplay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 由这台 Mac 上的其他账户安装，只有该账户可以修改。请登录该账户，重新安装 Bridgeplay。"
          }
        }
      }
    },
    "Steam was stopped, so start it again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato chiuso: riavvialo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已停止，请重新启动。"
          }
        }
      }
    },
    "Steam wasn't installed. %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non è stato installato. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 未能安装。%@"
          }
        }
      }
    },
    "Steam's default for Windows games." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il predefinito di Steam per i giochi Windows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 运行 Windows 游戏时的默认引擎。"
          }
        }
      }
    },
    "Steam's installed dylib does not match this account's build record. Finish or repair its installation with the Bridgeplay app that last installed it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dylib installata in Steam non corrisponde alla build registrata per questo account. Completa o ripara l'installazione con l'app Bridgeplay che l'ha installata per ultima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中已安装的动态库与当前账户的版本记录不一致。请使用上次执行安装的 Bridgeplay 应用完成或修复安装。"
          }
        }
      }
    },
    "Steam's own switch. It also lists tools made for Linux, which do not run on a Mac. Leave it off." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un interruttore di Steam. Elenca anche strumenti fatti per Linux, che non girano su Mac. Lascialo disattivato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是 Steam 自带的开关。它还会列出为 Linux 制作的工具，这些工具无法在 Mac 上运行。请保持关闭。"
          }
        }
      }
    },
    "Steam's update removed Bridgeplay, so Windows games won't start." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aggiornamento di Steam ha rimosso Bridgeplay, quindi i giochi Windows non si avviano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 的更新移除了 Bridgeplay，因此 Windows 游戏无法启动。"
          }
        }
      }
    },
    "Step %lld of %lld" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passaggio %1$lld di %2$lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %lld 步，共 %lld 步"
          }
        }
      }
    },
    "Step %lld of %lld, %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passaggio %1$lld di %2$lld, %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %lld 步，共 %lld 步，%@"
          }
        }
      }
    },
    "Stopping Steam" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiusura di Steam"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在停止 Steam"
          }
        }
      }
    },
    "Support Wine: buy CrossOver" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostieni Wine: acquista CrossOver"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持 Wine：购买 CrossOver"
          }
        }
      }
    },
    "Takes what did not move, like a HUD or a menu, straight from the real frame instead of warping it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prende ciò che non si è mosso, come un HUD o un menu, direttamente dal fotogramma reale invece di deformarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有移动的部分（如 HUD 或菜单）直接取自真实帧，而不是做扭曲处理。"
          }
        }
      }
    },
    "Task Manager" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestione attività"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务管理器"
          }
        }
      }
    },
    "Tells the game the processor supports AVX2, which some recent games need to start." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice al gioco che il processore supporta AVX2, necessario per avviarsi ad alcuni giochi recenti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告知游戏处理器支持 AVX2，部分较新的游戏需要它才能启动。"
          }
        }
      }
    },
    "Template cleanup incomplete" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulizia dei modelli incompleta"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板清理未完成"
          }
        }
      }
    },
    "Templates %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelli %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板 %@"
          }
        }
      }
    },
    "Thanks to NotProton's contributors" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie a chi ha contribuito a NotProton"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢 NotProton 的所有贡献者"
          }
        }
      }
    },
    "Thanks to everyone who contributed on GitHub" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie a tutti quelli che hanno contribuito su GitHub"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢所有在 GitHub 上做出贡献的人"
          }
        }
      }
    },
    "Thanks! Your report is on its way." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie! Il tuo report è in arrivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谢谢！你的报告正在发送。"
          }
        }
      }
    },
    "The %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "The %@ cave at %@ is not empty. This ntdll is either already patched or not the build its hash claimed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cave %1$@ a %2$@ non è vuota. Questo ntdll ha già la patch oppure non è la build indicata dal suo hash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处的代码空隙非空。此 ntdll 可能已修补，或并非哈希值所对应的版本。"
          }
        }
      }
    },
    "The %@ detour goes to %@, below its cave at %@, so writing it would land in live code." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il detour %1$@ va a %2$@, sotto la sua cave a %3$@: scriverlo finirebbe nel codice in uso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 跳转目标为 %@，位于 %@ 处的代码空隙之前；写入会覆盖现有代码，已拒绝操作。"
          }
        }
      }
    },
    "The %@ detour is %lld bytes and the cave holds %lld, so writing it would overrun into live code." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il detour %1$@ è di %2$lld byte e la cave ne contiene %3$lld: scriverlo sconfinerebbe nel codice in uso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 跳转补丁有 %lld 字节，但代码空隙仅容纳 %lld 字节；写入会覆盖现有代码，已拒绝操作。"
          }
        }
      }
    },
    "The %@ hook site at %@ holds %@ instead of %@, so the offsets do not belong to this ntdll." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il punto di aggancio %1$@ a %2$@ contiene %3$@ invece di %4$@: gli offset non appartengono a questo ntdll."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处的挂钩位置内容为 %@，而非 %@，偏移量与此 ntdll 不匹配。"
          }
        }
      }
    },
    "The %@ ntdll at %@ hashes %@ and build %@ expects %@. It is already patched, or from another CrossOver build." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hash dell'ntdll %1$@ in %2$@ è %3$@ e la build %4$@ si aspetta %5$@. Ha già la patch, oppure viene da un'altra build di CrossOver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 处的 %1$@ ntdll 的哈希值为 %3$@，但构建版本 %4$@ 预期为 %5$@。该文件可能已修补，或来自其他 CrossOver 版本。"
          }
        }
      }
    },
    "The %@ ntdll file alignment %@ is not a power of two." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allineamento dei file dell'ntdll %1$@ (%2$@) non è una potenza di due."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ntdll 的文件对齐值 %@ 不是 2 的幂。"
          }
        }
      }
    },
    "The %@ ntdll has no PE header where its DOS stub points." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ntdll %@ non ha un'intestazione PE dove punta il suo stub DOS."
