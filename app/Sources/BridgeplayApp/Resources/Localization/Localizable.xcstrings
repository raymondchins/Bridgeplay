    },
    "This will restore Steam itself to its original state but does not remove the support components used by Bridgeplay." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam verrà riportato allo stato originale, ma i componenti di supporto usati da Bridgeplay non verranno rimossi."
