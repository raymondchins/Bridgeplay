    },
    "Bridgeplay has been partially removed, because Steam at %@ cannot be found. Delete that copy of Steam and reinstall it to fully remove Bridgeplay." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay è stato rimosso solo in parte, perché Steam in %@ non si trova. Elimina quella copia di Steam e reinstallala per rimuovere del tutto Bridgeplay."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay удалён частично, потому что Steam в %@ не найден. Удалите эту копию Steam и установите заново, чтобы полностью убрать Bridgeplay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay 仅被部分移除，因为找不到位于 %@ 的 Steam。请删除该 Steam 并重新安装，以完全移除 Bridgeplay。"
          }
        }
      }
    },
    "Bridgeplay has been removed." : {
      "localizations" : {
