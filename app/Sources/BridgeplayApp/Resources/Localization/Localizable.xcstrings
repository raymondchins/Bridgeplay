    "Automatic picks D3DMetal when the Game Porting Toolkit is linked, and DXMT otherwise." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico sceglie D3DMetal quando il Game Porting Toolkit è collegato, altrimenti DXMT."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Автоматически» выбирает D3DMetal, если подключён Game Porting Toolkit, иначе DXMT."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
