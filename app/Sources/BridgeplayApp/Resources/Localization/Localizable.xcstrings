    "Installing the Game Porting Toolkit" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installazione del Game Porting Toolkit"
          }
        },
        "ru" : {
          "stringUnit" : {
