    },
    "The %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "The %@ cave at %@ is not empty. This ntdll is either already patched or not the build its hash claimed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cave %1$@ a %2$@ non è vuota. Questo ntdll ha già la patch oppure non è la build indicata dal suo hash."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cave %@ по адресу %@ не пуст. Этот ntdll уже пропатчен или не та сборка, которую указывает его хеш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处的代码空隙非空。此 ntdll 可能已修补，或并非哈希值所对应的版本。"
          }
        }
      }
    },
    "The %@ detour goes to %@, below its cave at %@, so writing it would land in live code." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il detour %1$@ va a %2$@, sotto la sua cave a %3$@: scriverlo finirebbe nel codice in uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detour %@ ведёт на %@, ниже его cave по адресу %@, поэтому запись попала бы в рабочий код."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 跳转目标为 %@，位于 %@ 处的代码空隙之前；写入会覆盖现有代码，已拒绝操作。"
          }
        }
      }
    },
    "The %@ detour is %lld bytes and the cave holds %lld, so writing it would overrun into live code." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il detour %1$@ è di %2$lld byte e la cave ne contiene %3$lld: scriverlo sconfinerebbe nel codice in uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detour %@ занимает %lld байт, а в cave помещается %lld, поэтому запись вышла бы за границы в рабочий код."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 跳转补丁有 %lld 字节，但代码空隙仅容纳 %lld 字节；写入会覆盖现有代码，已拒绝操作。"
          }
        }
      }
    },
    "The %@ hook site at %@ holds %@ instead of %@, so the offsets do not belong to this ntdll." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il punto di aggancio %1$@ a %2$@ contiene %3$@ invece di %4$@: gli offset non appartengono a questo ntdll."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В точке перехвата %@ по адресу %@ находится %@ вместо %@, поэтому смещения не относятся к этому ntdll."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处的挂钩位置内容为 %@，而非 %@，偏移量与此 ntdll 不匹配。"
          }
        }
      }
    },
    "The %@ ntdll at %@ hashes %@ and build %@ expects %@. It is already patched, or from another CrossOver build." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hash dell'ntdll %1$@ in %2$@ è %3$@ e la build %4$@ si aspetta %5$@. Ha già la patch, oppure viene da un'altra build di CrossOver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хеш ntdll %@ по пути %@ равен %@, а сборка %@ ожидает %@. Он уже пропатчен или из другой сборки CrossOver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 处的 %1$@ ntdll 的哈希值为 %3$@，但构建版本 %4$@ 预期为 %5$@。该文件可能已修补，或来自其他 CrossOver 版本。"
          }
        }
      }
    },
    "The %@ ntdll file alignment %@ is not a power of two." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allineamento dei file dell'ntdll %1$@ (%2$@) non è una potenza di due."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выравнивание файла ntdll %@ (%@) не является степенью двойки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ntdll 的文件对齐值 %@ 不是 2 的幂。"
          }
        }
      }
    },
    "The %@ ntdll has no PE header where its DOS stub points." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ntdll %@ non ha un'intestazione PE dove punta il suo stub DOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В ntdll %@ нет заголовка PE там, куда указывает его DOS-заглушка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ntdll 的 DOS 存根所指向的位置没有 PE 头。"
          }
        }
      }
    },
    "The %@ ntdll has no free section header slot for the detour." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ntdll %@ non ha uno spazio libero tra le intestazioni di sezione per il detour."
