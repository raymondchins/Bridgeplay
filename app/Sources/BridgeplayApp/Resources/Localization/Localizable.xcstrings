            "value" : "取消"
          }
        }
      }
    },
    "Changes apply the next time a game starts. A game's own settings in Steam Properties › Bridgeplay win over these." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche valgono dal prossimo avvio di un gioco. Le impostazioni di un gioco in Proprietà di Steam › Bridgeplay hanno la precedenza su queste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения вступят в силу при следующем запуске игры. Собственные настройки игры в свойствах Steam › Bridgeplay важнее этих."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改将在游戏下次启动时生效。单个游戏在 Steam 属性 › Bridgeplay 中的设置优先于这里。"
          }
        }
      }
    },
    "Check for Updates…" : {
      "localizations" : {
