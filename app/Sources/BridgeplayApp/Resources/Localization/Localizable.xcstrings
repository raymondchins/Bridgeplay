        }
      }
    },
    "Waiting for you to sign in to Steam. Bridgeplay doesn't read or store your password." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa del tuo accesso a Steam. Bridgeplay non legge né salva la tua password."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидание входа в Steam. Bridgeplay не читает и не хранит ваш пароль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等你登录 Steam。Bridgeplay 不会读取或保存你的密码。"
          }
        }
      }
    },
    "Waits for the display even when a game turns VSync off." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attende lo schermo anche quando un gioco disattiva VSync."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ждёт дисплей, даже если игра отключает VSync."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使游戏关闭了垂直同步，也会等待显示器刷新。"
          }
        }
      }
    },
    "What went wrong? Optional, and public with the report." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa non ha funzionato? Facoltativo, e pubblico insieme al report."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что пошло не так? Необязательно; текст будет виден всем вместе с отчётом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪里出了问题？可不填，会随报告公开。"
          }
        }
      }
    },
    "What's New" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novità"
          }
        },
        "ru" : {
          "stringUnit" : {
