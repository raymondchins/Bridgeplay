        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次启动需要更长时间"
          }
        }
      }
    },
    "The first launch takes longer. The game may show a black screen for a while after it opens." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo avvio richiede più tempo. Una volta aperto, il gioco potrebbe mostrare una schermata nera per un po'."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первый запуск идёт дольше. После открытия игра может какое-то время показывать чёрный экран."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
