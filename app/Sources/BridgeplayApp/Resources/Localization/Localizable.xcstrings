            "value" : "Da sapere"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "须知"
          }
        }
      }
    },
    "Graphics" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafica"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图形"
          }
        }
      }
    },
    "Graphics Backend" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
