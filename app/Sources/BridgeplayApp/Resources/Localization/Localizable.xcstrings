      }
    },
    "Rebuilt %lld prefixes. Each original is kept beside the game's prefix. Check that your saves are present in the games, then delete the backups to save space." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruiti %lld prefissi. Ogni originale è conservato accanto al prefisso del gioco. Controlla che i salvataggi siano presenti nei giochi, poi elimina i backup per liberare spazio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пересозданных префиксов: %lld. Каждый оригинал сохранён рядом с префиксом игры. Убедитесь, что сохранения в играх на месте, и удалите копии, чтобы освободить место."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已重建 %lld 个游戏容器。各原容器均保存在对应游戏容器旁。请先进入游戏确认存档正常，再删除备份以释放空间。"
          }
        }
      }
    },
    "Rebuilt the prefix for %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruito il prefisso di %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Префикс для %@ пересоздан."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已重建“%@”的游戏容器。"
          }
        }
      }
    },
    "Rebuilt the prefix for %@. The original is at %@. Check that your save is present in the game, then delete the backup to save space." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruito il prefisso di %1$@. L'originale è in %2$@. Controlla che il salvataggio sia presente nel gioco, poi elimina il backup per liberare spazio."
          }
        },
        "ru" : {
