    "A newer Bridgeplay build is installed. Use that build to update or repair the installed files." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È installata una build più recente di Bridgeplay. Usa quella build per aggiornare o riparare i file installati."
