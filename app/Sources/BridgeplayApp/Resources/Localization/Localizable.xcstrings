        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay 会忽略超过 1024 个字符的值。"
          }
        }
      }
    },
    "Bridgeplay ignores a value with a backtick, $( or a quote." : {
      "localizations" : {
        "it" : {
