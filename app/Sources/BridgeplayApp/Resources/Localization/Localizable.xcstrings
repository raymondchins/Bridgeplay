    "Built-in optical flow" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flusso ottico integrato"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенный оптический поток"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置光流"
          }
        }
      }
    },
    "Built-in optical flow follows the mode above. MetalFX uses Apple's frame interpolation and makes one frame per pair." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il flusso ottico integrato segue la modalità qui sopra. MetalFX usa l'interpolazione di Apple e genera un fotogramma per ogni coppia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенный оптический поток следует режиму выше. MetalFX использует интерполяцию кадров Apple и создаёт один кадр на пару."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置光流遵循上方的模式。MetalFX 使用 Apple 的插帧，每对帧生成一帧。"
          }
        }
      }
    },
    "Calculating…" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
