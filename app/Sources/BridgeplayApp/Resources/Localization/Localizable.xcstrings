    "Report an NVIDIA GPU" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala una GPU NVIDIA"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
