{
  "sourceLanguage" : "en",
  "strings" : {
    " Bridgeplay can be deployed, but the CrossOver compatibility tool cannot be installed without a valid license." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Bridgeplay può essere installato, ma lo strumento di compatibilità di CrossOver non può essere installato senza una licenza valida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Bridgeplay можно развернуть, но инструмент совместимости CrossOver не установить без действующей лицензии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 可以部署 Bridgeplay，但没有有效许可证时无法安装 CrossOver 兼容工具。"
          }
        }
      }
    },
    " with %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " con %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " с %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（使用 %@）"
          }
        }
      }
    },
    "%@ and %@ both come from %@ but pin different hashes." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ vengono entrambi da %3$@ ma fissano hash diversi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и %@ взяты из %@, но закрепляют разные хеши."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 和 %@ 均来自 %@，但指定了不同的哈希值。"
          }
        }
      }
    },
    "%@ at %@ spans %lld bytes, past the end of a %lld byte file." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@ occupa %3$lld byte, oltre la fine di un file di %4$lld byte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ по адресу %@ занимает %lld байт и выходит за конец файла размером %lld байт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 处的%1$@占用 %3$lld 字节，超出了文件的 %4$lld 字节长度。"
          }
        }
      }
    },
    "%@ available, 3 GB needed" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disponibili, ne servono 3 GB"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступно %@, нужно 3 ГБ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空间 %@，需要 3 GB"
          }
        }
      }
    },
    "%@ belongs to the system (root), not to your account, so Bridgeplay cannot change it. An administrator has to make your account its owner, for example by running this in Terminal: %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ appartiene al sistema (root), non al tuo account, quindi Bridgeplay non può modificarlo. Un amministratore deve rendere il tuo account proprietario, per esempio eseguendo questo comando nel Terminale: %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ принадлежит системе (root), а не вашей учётной записи, поэтому Bridgeplay не может его изменить. Администратору нужно сделать вашу учётную запись владельцем, например выполнив в Терминале: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 属于系统（root），而不是你的账户，因此 Bridgeplay 无法修改它。需要由管理员将其所有者改为你的账户，例如在“终端”中运行：%@"
          }
        }
      }
    },
    "%@ carries no entitlements to extend." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha entitlement da estendere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ нет entitlements, которые можно расширить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不包含可扩展的授权项。"
          }
        }
      }
    },
    "%@ could not be copied out of the prefix. The prefix has been left as it was and nothing has been lost. Check free space and permissions, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile copiare %@ fuori dal prefisso. Il prefisso è rimasto com'era e non è andato perso nulla. Controlla lo spazio libero e i permessi, poi riprova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не удалось скопировать из префикса. Префикс остался как был, ничего не потеряно. Проверьте свободное место и права доступа и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从容器中复制 %@。容器保持原样，未丢失任何内容。请检查剩余空间和权限，然后重试。"
          }
        }
      }
    },
    "%@ could not be read as a property list." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %@ come property list."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не удалось прочитать как список свойств."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将 %@ 读取为属性列表。"
          }
        }
      }
    },
    "%@ could not be read. %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %1$@. %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не удалось прочитать. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。%@"
          }
        }
      }
    },
    "%@ could not be signed. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile firmare %@. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не удалось подписать. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法对 %@ 签名。"
          }
        }
      }
    },
    "%@ could not be written. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scrivere %@. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не удалось записать. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入 %@。"
          }
        }
      }
    },
    "%@ did not contain %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non conteneva %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не содержит %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中不包含 %@。"
          }
        }
      }
    },
    "%@ does not appear to have a prefix to back up." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non sembra avere un prefisso di cui fare il backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@, похоже, нет префикса для резервного копирования."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 似乎没有可备份的游戏容器。"
          }
        }
      }
    },
    "%@ does not verify against its own signature. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non corrisponde alla propria firma. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не проходит проверку по собственной подписи. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未通过自身签名验证。"
          }
        }
      }
    },
    "%@ failed with status %d." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è riuscito (stato %2$d)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: сбой, статус %d."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d。"
          }
        }
      }
    },
    "%@ failed with status %d: %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è riuscito (stato %2$d): %3$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: сбой, статус %d: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d：%@"
          }
        }
      }
    },
    "%@ has a broken signature" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha una firma danneggiata"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ повреждена подпись"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的签名损坏"
          }
        }
      }
    },
    "%@ has no prefix at %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non ha un prefisso in %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ нет префикса в %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处没有游戏容器。"
          }
        }
      }
    },
    "%@ is already listed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già nell'elenco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже в списке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在列表中。"
          }
        }
      }
    },
    "%@ is already set up in Steam, and Bridgeplay won't install on top of it. Repair Steam to remove it, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già configurato in Steam e Bridgeplay non si installa sopra. Ripara Steam per rimuoverlo, poi riprova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже настроен в Steam, и Bridgeplay не будет устанавливаться поверх него. Восстановите Steam, чтобы убрать его, и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 Steam 中设置，Bridgeplay 不会覆盖安装。请修复 Steam 将其移除，然后重试。"
          }
        }
      }
    },
    "%@ is already set up in Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già configurato in Steam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже настроен в Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 Steam 中设置。"
          }
        }
      }
    },
    "%@ is already set up in Steam. Repair Steam to remove it, and Setup continues by itself." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già configurato in Steam. Ripara Steam per rimuoverlo e la configurazione prosegue da sola."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже настроен в Steam. Восстановите Steam, чтобы убрать его, и настройка продолжится сама."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 Steam 中设置。修复 Steam 即可将其移除，设置会自动继续。"
          }
        }
      }
    },
    "%@ is left from a rebuild that did not finish and may hold the only copy of the saves. Move it somewhere safe, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è rimasto da una ricostruzione non completata e potrebbe contenere l'unica copia dei salvataggi. Spostalo in un posto sicuro, poi riprova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ остался после незавершённой пересборки и может хранить единственную копию сохранений. Переместите его в безопасное место и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是上次未完成重建留下的文件，可能保存着唯一的游戏存档。请先将其移到安全位置，然后重试。"
          }
        }
      }
    },
    "%@ is missing the dyld entitlement" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ manca l'entitlement dyld"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ нет entitlement для dyld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 缺少 dyld 授权项"
          }
        }
      }
    },
    "%@ is not Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è Steam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — не Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam。"
          }
        }
      }
    },
    "%@ is not a Windows program. Pick an exe, msi, bat or cmd file." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un programma Windows. Scegli un file exe, msi, bat o cmd."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — не программа для Windows. Выберите файл exe, msi, bat или cmd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Windows 程序。请选择 exe、msi、bat 或 cmd 文件。"
          }
        }
      }
    },
    "%@ is not a supported build. Supported: %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è una build supportata. Supportate: %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — неподдерживаемая сборка. Поддерживаются: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持构建版本 %@。支持的版本：%@。"
          }
        }
      }
    },
    "%@ is not a valid copy of CrossOver." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è una copia valida di CrossOver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — недопустимая копия CrossOver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是有效的 CrossOver 应用。"
          }
        }
      }
    },
    "%@ is not signed by Valve. Expected TeamIdentifier=%@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è firmato da Valve. Atteso TeamIdentifier=%2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не подписан Valve. Ожидался TeamIdentifier=%@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 并非由 Valve 签名。预期 TeamIdentifier=%@。"
          }
        }
      }
    },
    "%@ is not the Steam bundle. Expected Identifier=%@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è il bundle di Steam. Atteso Identifier=%2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — не пакет Steam. Ожидался Identifier=%@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam 应用包。预期 Identifier=%@。"
          }
        }
      }
    },
    "%@ is not there, so there is nothing to install into." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non c'è, quindi non c'è niente in cui installare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не найден, поэтому устанавливать некуда."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不存在，无法安装。"
          }
        }
      }
    },
    "%@ is running. Quit the game first." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione. Esci prima dal gioco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущено: %@. Сначала завершите игру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行。请先退出游戏。"
          }
        }
      }
    },
    "%@ names the package %@, which is not declared. Declared: %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ indica il pacchetto %2$@, che non è dichiarato. Dichiarati: %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ указывает пакет %@, который не объявлен. Объявлены: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 指定了未声明的软件包 %@。已声明：%@。"
          }
        }
      }
    },
    "%@ templates %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
