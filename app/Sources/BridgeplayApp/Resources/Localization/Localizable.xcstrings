        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工具用于修复在 Rosetta 与 FEX 版 CrossOver 之间切换后的游戏容器。"
          }
        }
      }
    },
    "This version of Bridgeplay has newer files for Steam." : {
