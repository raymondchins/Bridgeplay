        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的 Bridgeplay 包含适用于 Steam 的较新文件。"
          }
        }
      }
    },
    "This will DELETE the game's prefix." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prefisso del gioco verrà ELIMINATO."
