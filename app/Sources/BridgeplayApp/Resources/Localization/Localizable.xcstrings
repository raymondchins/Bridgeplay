    },
    "Bridgeplay is trusted on this Mac. Controllers keep their permission after the next update." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay è considerato attendibile su questo Mac. I controller mantengono il permesso anche dopo il prossimo aggiornamento."
          }
        },
