{
  "sourceLanguage" : "en",
  "strings" : {
    " Bridgeplay can be deployed, but the CrossOver compatibility tool cannot be installed without a valid license." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Bridgeplay può essere installato, ma lo strumento di compatibilità di CrossOver non può essere installato senza una licenza valida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 可以部署 Bridgeplay，但没有有效许可证时无法安装 CrossOver 兼容工具。"
          }
        }
      }
    },
    " with %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " con %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（使用 %@）"
          }
        }
      }
    },
    "%@ and %@ both come from %@ but pin different hashes." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ vengono entrambi da %3$@ ma fissano hash diversi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 和 %@ 均来自 %@，但指定了不同的哈希值。"
          }
        }
      }
    },
    "%@ at %@ spans %lld bytes, past the end of a %lld byte file." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@ occupa %3$lld byte, oltre la fine di un file di %4$lld byte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 处的%1$@占用 %3$lld 字节，超出了文件的 %4$lld 字节长度。"
          }
        }
      }
    },
    "%@ available, 3 GB needed" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disponibili, ne servono 3 GB"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空间 %@，需要 3 GB"
          }
        }
      }
    },
    "%@ belongs to the system (root), not to your account, so Bridgeplay cannot change it. An administrator has to make your account its owner, for example by running this in Terminal: %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ appartiene al sistema (root), non al tuo account, quindi Bridgeplay non può modificarlo. Un amministratore deve rendere il tuo account proprietario, per esempio eseguendo questo comando nel Terminale: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 属于系统（root），而不是你的账户，因此 Bridgeplay 无法修改它。需要由管理员将其所有者改为你的账户，例如在“终端”中运行：%@"
          }
        }
      }
    },
    "%@ carries no entitlements to extend." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha entitlement da estendere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不包含可扩展的授权项。"
          }
        }
      }
    },
    "%@ could not be copied out of the prefix. The prefix has been left as it was and nothing has been lost. Check free space and permissions, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile copiare %@ fuori dal prefisso. Il prefisso è rimasto com'era e non è andato perso nulla. Controlla lo spazio libero e i permessi, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从容器中复制 %@。容器保持原样，未丢失任何内容。请检查剩余空间和权限，然后重试。"
          }
        }
      }
    },
    "%@ could not be read as a property list." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %@ come property list."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将 %@ 读取为属性列表。"
          }
        }
      }
    },
    "%@ could not be read. %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %1$@. %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。%@"
          }
        }
      }
    },
    "%@ could not be signed. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile firmare %@. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法对 %@ 签名。"
          }
        }
      }
    },
    "%@ could not be written. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scrivere %@. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入 %@。"
          }
        }
      }
    },
    "%@ did not contain %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non conteneva %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中不包含 %@。"
          }
        }
      }
    },
    "%@ does not appear to have a prefix to back up." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non sembra avere un prefisso di cui fare il backup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 似乎没有可备份的游戏容器。"
          }
        }
      }
    },
    "%@ does not verify against its own signature. " : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non corrisponde alla propria firma. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未通过自身签名验证。"
          }
        }
      }
    },
    "%@ failed with status %d." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è riuscito (stato %2$d)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d。"
          }
        }
      }
    },
    "%@ failed with status %d: %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è riuscito (stato %2$d): %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d：%@"
          }
        }
      }
    },
    "%@ has a broken signature" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha una firma danneggiata"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的签名损坏"
          }
        }
      }
    },
    "%@ has no prefix at %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non ha un prefisso in %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处没有游戏容器。"
          }
        }
      }
    },
    "%@ is already listed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già nell'elenco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在列表中。"
          }
        }
      }
    },
    "%@ is left from a rebuild that did not finish and may hold the only copy of the saves. Move it somewhere safe, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è rimasto da una ricostruzione non completata e potrebbe contenere l'unica copia dei salvataggi. Spostalo in un posto sicuro, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是上次未完成重建留下的文件，可能保存着唯一的游戏存档。请先将其移到安全位置，然后重试。"
          }
        }
      }
    },
    "%@ is missing the dyld entitlement" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ manca l'entitlement dyld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 缺少 dyld 授权项"
          }
        }
      }
    },
    "%@ is not Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam。"
          }
        }
      }
    },
    "%@ is not a Windows program. Pick an exe, msi, bat or cmd file." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un programma Windows. Scegli un file exe, msi, bat o cmd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Windows 程序。请选择 exe、msi、bat 或 cmd 文件。"
          }
        }
      }
    },
    "%@ is not a supported build. Supported: %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è una build supportata. Supportate: %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持构建版本 %@。支持的版本：%@。"
          }
        }
      }
    },
    "%@ is not a valid copy of CrossOver." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è una copia valida di CrossOver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是有效的 CrossOver 应用。"
          }
        }
      }
    },
    "%@ is not signed by Valve. Expected TeamIdentifier=%@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è firmato da Valve. Atteso TeamIdentifier=%2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 并非由 Valve 签名。预期 TeamIdentifier=%@。"
          }
        }
      }
    },
    "%@ is not the Steam bundle. Expected Identifier=%@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è il bundle di Steam. Atteso Identifier=%2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam 应用包。预期 Identifier=%@。"
          }
        }
      }
    },
    "%@ is not there, so there is nothing to install into." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non c'è, quindi non c'è niente in cui installare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不存在，无法安装。"
          }
        }
      }
    },
    "%@ is running. Quit the game first." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione. Esci prima dal gioco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行。请先退出游戏。"
          }
        }
      }
    },
    "%@ names the package %@, which is not declared. Declared: %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ indica il pacchetto %2$@, che non è dichiarato. Dichiarati: %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 指定了未声明的软件包 %@。已声明：%@。"
          }
        }
      }
    },
    "%@ templates %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelli %1$@ %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 模板 %@"
          }
        }
      }
    },
    "%@ was last run by %@, which is no longer set up. Rebuild the prefix first." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è stato avviato l'ultima volta con %2$@, che non è più configurato. Ricostruisci prima il prefisso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上次使用 %@ 运行，但该兼容工具已不可用。请先重建游戏容器。"
          }
        }
      }
    },
    "%@ was re-signed without the dyld entitlement." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato rifirmato senza l'entitlement dyld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 重新签名后缺少 dyld 授权项。"
          }
        }
      }
    },
    "%@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@, %@ private size" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, dimensione %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，独占空间 %@"
          }
        }
      }
    },
    "%@. Update macOS first." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Aggiorna prima macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。请先更新 macOS。"
          }
        }
      }
    },
    "%@.%@ is missing from the app's resources." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@.%2$@ manca dalle risorse dell'app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用资源中缺少 %@.%@。"
          }
        }
      }
    },
    "%@.bin could not be read. %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %1$@.bin. %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@.bin。%@"
          }
        }
      }
    },
    "%@.bin hashes %@ and should hash %@, so the shipped detour is not the one that was built." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hash di %1$@.bin è %2$@ e dovrebbe essere %3$@: il detour incluso non è quello compilato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.bin 的哈希值为 %@，预期为 %@；附带的跳转补丁与构建结果不一致。"
          }
        }
      }
    },
    "%@.bin is missing from the app's resources." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.bin manca dalle risorse dell'app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用资源中缺少 %@.bin。"
          }
        }
      }
    },
    "%@/%@ is missing" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@/%2$@ manca"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺少 %@/%@"
          }
        }
      }
    },
    "%@/%@ is not in the bridge. Install Bridgeplay first." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@/%2$@ non è nel bridge. Installa prima Bridgeplay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接组件中没有 %@/%@。请先安装 Bridgeplay。"
          }
        }
      }
    },
    "%@/%@ is not the build %@ copy. Expected %@, found %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@/%2$@ non è la copia della build %3$@. Atteso %4$@, trovato %5$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/%@ 不属于构建版本 %@。预期为 %@，实际为 %@。"
          }
        }
      }
    },
    "%@/%@ is out of date" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@/%2$@ non è aggiornato"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/%@ 已过期"
          }
        }
      }
    },
    "%@/ntdll.dll is missing" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/ntdll.dll manca"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺少 %@/ntdll.dll"
          }
        }
      }
    },
    "%@/ntdll.dll is missing from %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@/ntdll.dll manca da %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 中缺少 %1$@/ntdll.dll。"
          }
        }
      }
    },
    "%@/ntdll.dll is not the patched copy" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/ntdll.dll non è la copia con la patch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/ntdll.dll 不是已修补的副本"
          }
        }
      }
    },
    "%lld" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        }
      }
    },
    "%lld backups" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld backup"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个备份"
          }
        }
      }
    },
    "%lld of %lld" : {
      "localizations" : {
        "it" : {
