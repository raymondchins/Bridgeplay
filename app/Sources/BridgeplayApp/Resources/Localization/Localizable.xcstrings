        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ntdll 的 DOS 存根所指向的位置没有 PE 头。"
          }
        }
      }
    },
    "The %@ ntdll has no free section header slot for the detour." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ntdll %@ non ha uno spazio libero tra le intestazioni di sezione per il detour."
