        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ntdll 没有可供跳转补丁使用的空闲节头槽位。"
          }
        }
      }
    },
    "The %@ ntdll image ends at %@, and the detour section was pinned at %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'immagine dell'ntdll %1$@ finisce a %2$@, e la sezione del detour era fissata a %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Образ ntdll %@ заканчивается на %@, а секция detour была закреплена на %@."
