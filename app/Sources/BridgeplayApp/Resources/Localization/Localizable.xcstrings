    },
    "The first time a game uses a controller, macOS asks to let Steam use Input Monitoring. Click Allow. If you missed it, turn on Steam in Input Monitoring." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prima volta che un gioco usa un controller, macOS chiede di consentire a Steam il Monitoraggio input. Fai clic su Consenti. Se non l'hai visto, attiva Steam in Monitoraggio input."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏第一次使用控制器时，macOS 会询问是否允许 Steam 使用“输入监控”。请点击“允许”。如果错过了，请在“输入监控”中开启 Steam。"
          }
        }
      }
    },
    "The game SAVE DATA inside the prefix WILL BE LOST." : {
