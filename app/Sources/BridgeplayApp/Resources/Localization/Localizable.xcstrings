          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay 正忙，暂时不会重启。退出时会安装更新。"
          }
        }
      }
    },
    "Bridgeplay is installed in %@. Use Repair Steam to remove it before choosing another copy of Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay è installato in %@. Usa Ripara Steam per rimuoverlo prima di scegliere un'altra copia di Steam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay установлен в %@. Прежде чем выбрать другую копию Steam, удалите его кнопкой «Восстановить Steam»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay 已安装在 %@ 中。请先使用“修复 Steam”将其移除，再选择另一份 Steam。"
          }
        }
      }
    },
    "Bridgeplay is missing its %@. An antivirus or endpoint protection app may have quarantined it. Restore or allow the file, or exclude Bridgeplay.app, then reinstall Bridgeplay." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Bridgeplay manca il file %@. Un antivirus o un'app di protezione endpoint potrebbe averlo messo in quarantena. Ripristina o consenti il file, oppure escludi Bridgeplay.app, quindi reinstalla Bridgeplay."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Bridgeplay не хватает файла %@. Возможно, антивирус или программа защиты поместили его в карантин. Восстановите или разрешите этот файл либо добавьте Bridgeplay.app в исключения, затем переустановите Bridgeplay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay 缺少 %@。杀毒软件或终端防护应用可能已将其隔离。请恢复或允许该文件，或将 Bridgeplay.app 加入排除列表，然后重新安装 Bridgeplay。"
          }
        }
      }
    },
    "Bridgeplay is rebuilding the prefix for %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
