        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或从 Apple 下载"
          }
        }
      }
    },
    "Other lines in gamefixes/default.conf are kept as they are." : {
      "localizations" : {
