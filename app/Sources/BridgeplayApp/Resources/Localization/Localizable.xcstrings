    },
    "The %@ ntdll is based at %@, and the detour was linked against %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ntdll %1$@ ha base %2$@, e il detour è stato collegato per %3$@."
