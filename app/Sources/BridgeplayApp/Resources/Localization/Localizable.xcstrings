            "state" : "translated",
            "value" : "Поддержите Wine: купите CrossOver"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持 Wine：购买 CrossOver"
          }
        }
      }
    },
    "Takes what did not move, like a HUD or a menu, straight from the real frame instead of warping it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prende ciò che non si è mosso, come un HUD o un menu, direttamente dal fotogramma reale invece di deformarlo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берёт неподвижные элементы, например HUD или меню, прямо из настоящего кадра, не искажая их."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有移动的部分（如 HUD 或菜单）直接取自真实帧，而不是做扭曲处理。"
          }
        }
      }
    },
    "Task Manager" : {
