    },
    "macOS asks for your Mac password once, so Steam keeps working with Bridgeplay. Type it and choose Always Allow, and it won't ask again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chiede una volta la password del Mac, così Steam continua a funzionare con Bridgeplay. Inseriscila e scegli Consenti sempre: non te la chiederà più."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS один раз запросит пароль вашего Mac, чтобы Steam продолжал работать с Bridgeplay. Введите его и выберите «Всегда разрешать», и запрос больше не появится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 会请你输入一次 Mac 密码，让 Steam 能继续配合 Bridgeplay 使用。输入后选择“始终允许”，之后就不会再询问。"
          }
        }
      }
    },
    "macOS did not add the certificate to your keychain." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha aggiunto il certificato al tuo portachiavi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не добавила сертификат в вашу связку ключей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 未将证书添加到你的钥匙串。"
          }
        }
      }
    },
    "macOS did not reset %@ for Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha azzerato %@ per Steam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не сбросила %@ для Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 未能重置 Steam 的 %@ 权限。"
          }
        }
      }
    },
    "macOS kept Steam's old controller permission. In Input Monitoring, turn Steam off and on again, then restart Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ha mantenuto il vecchio permesso del controller di Steam. In Monitoraggio input, disattiva e riattiva Steam, poi riavvia Steam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS сохранила старое разрешение Steam для геймпада. В разделе «Мониторинг ввода» выключите и снова включите Steam, затем перезапустите Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 保留了 Steam 旧的控制器权限。请在“输入监控”中将 Steam 关闭再重新开启，然后重启 Steam。"
          }
        }
      }
    },
    "macOS needs your permission first." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ha prima bisogno del tuo permesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала нужно ваше разрешение в macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 需要先获得你的许可。"
          }
        }
      }
    },
    "names no CDN host to fetch from." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "non indica un host CDN da cui scaricare."
          }
        },
        "ru" : {
