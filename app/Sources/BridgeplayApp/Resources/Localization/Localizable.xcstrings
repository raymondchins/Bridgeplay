      }
    },
    "This folder belongs to the system (root), and your account cannot write to it. Try again from an administrator account, or ask an administrator for help." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa cartella appartiene al sistema (root) e il tuo account non può scriverci. Riprova da un account amministratore oppure chiedi aiuto a un amministratore."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件夹属于系统（root），你的账户无法写入。请使用管理员账户重试，或向管理员寻求帮助。"
          }
        }
      }
    },
    "This tool is intended to repair a prefix after switching between Rosetta/FEX CrossOver." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo strumento serve a riparare un prefisso dopo il passaggio tra CrossOver Rosetta e FEX."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工具用于修复在 Rosetta 与 FEX 版 CrossOver 之间切换后的游戏容器。"
          }
        }
      }
    },
    "This version of Bridgeplay has newer files for Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione di Bridgeplay include file più recenti per Steam."
          }
