        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non funzionano. Il loro anti-cheat richiede un driver di Windows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法运行。其反作弊程序需要 Windows 驱动程序。"
