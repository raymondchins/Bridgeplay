    "Built on [NotProton](https://github.com/NotProtonNot/NotProton) and CodeWeavers' Wine.\nSupport Wine: [buy CrossOver](https://www.codeweavers.com/crossover)." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basato su [NotProton](https://github.com/NotProtonNot/NotProton) e sul Wine di CodeWeavers.\nSostieni Wine: [acquista CrossOver](https://www.codeweavers.com/crossover)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создан на основе [NotProton](https://github.com/NotProtonNot/NotProton) и Wine от CodeWeavers.\nПоддержите Wine: [купите CrossOver](https://www.codeweavers.com/crossover)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于 [NotProton](https://github.com/NotProtonNot/NotProton) 和 CodeWeavers 的 Wine。\n支持 Wine：[购买 CrossOver](https://www.codeweavers.com/crossover)。"
          }
        }
