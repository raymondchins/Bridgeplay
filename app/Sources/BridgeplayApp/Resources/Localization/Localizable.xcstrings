        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay 会忽略含有控制字符的值。"
          }
        }
      }
    },
    "Bridgeplay is busy, so it won't restart yet. The update installs when you quit." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgeplay è occupato, quindi non si riavvierà ora. L'aggiornamento verrà installato quando chiudi l'app."
          }
        },
        "ru" : {
          "stringUnit" : {
