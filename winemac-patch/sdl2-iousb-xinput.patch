+static void IOUSBXINPUT_JoystickUpdate(SDL_Joystick *joystick)
+{
+    struct joystick_hwdata *hw = joystick->hwdata;
+    uint8_t buf[64];
+    uint32_t len = 0;
+    SDL_bool has_data = SDL_FALSE;
+    SDL_bool is_removed = SDL_FALSE;
+
+    if (!hw) {
+        return;
+    }
+
+    if (!hw->axes_zero_set && joystick->axes && joystick->naxes >= 6) {
+        /* Atur titik nol trigger sesudah SDL mengalokasikan array axes */
+        joystick->axes[2].zero = -32768;
+        joystick->axes[5].zero = -32768;
+        hw->axes_zero_set = SDL_TRUE;
+    }
+
+    pthread_mutex_lock(&hw->lock);
+    is_removed = hw->removed;
+    if (hw->has_report && hw->report_len >= 20) {
+        memcpy(buf, hw->report, hw->report_len);
+        len = hw->report_len;
+        has_data = SDL_TRUE;
+        hw->has_report = SDL_FALSE;
+    }
+    pthread_mutex_unlock(&hw->lock);
+
+    if (is_removed || !has_data || len < 20 || buf[0] != 0x00) {
+        return;
+    }
+
+    /* Terjemahkan D-pad ke hat 0 */
+    {
+        Uint8 hat = SDL_HAT_CENTERED;
+        if (buf[2] & 0x01) {
+            hat |= SDL_HAT_UP;
+        }
+        if (buf[2] & 0x02) {
+            hat |= SDL_HAT_DOWN;
+        }
+        if (buf[2] & 0x04) {
+            hat |= SDL_HAT_LEFT;
+        }
+        if (buf[2] & 0x08) {
+            hat |= SDL_HAT_RIGHT;
+        }
+        if ((hat & SDL_HAT_UP) && (hat & SDL_HAT_DOWN)) {
+            hat &= (Uint8)~(SDL_HAT_UP | SDL_HAT_DOWN);
+        }
+        if ((hat & SDL_HAT_LEFT) && (hat & SDL_HAT_RIGHT)) {
+            hat &= (Uint8)~(SDL_HAT_LEFT | SDL_HAT_RIGHT);
+        }
+        SDL_PrivateJoystickHat(joystick, 0, hat);
+    }
+
+    /* Terjemahkan tombol XInput standar */
+    SDL_PrivateJoystickButton(joystick, 0, (buf[3] & 0x10) ? SDL_PRESSED : SDL_RELEASED);  /* A */
+    SDL_PrivateJoystickButton(joystick, 1, (buf[3] & 0x20) ? SDL_PRESSED : SDL_RELEASED);  /* B */
+    SDL_PrivateJoystickButton(joystick, 2, (buf[3] & 0x40) ? SDL_PRESSED : SDL_RELEASED);  /* X */
+    SDL_PrivateJoystickButton(joystick, 3, (buf[3] & 0x80) ? SDL_PRESSED : SDL_RELEASED);  /* Y */
+    SDL_PrivateJoystickButton(joystick, 4, (buf[3] & 0x01) ? SDL_PRESSED : SDL_RELEASED);  /* LB */
+    SDL_PrivateJoystickButton(joystick, 5, (buf[3] & 0x02) ? SDL_PRESSED : SDL_RELEASED);  /* RB */
+    SDL_PrivateJoystickButton(joystick, 6, (buf[2] & 0x20) ? SDL_PRESSED : SDL_RELEASED);  /* Back */
+    SDL_PrivateJoystickButton(joystick, 7, (buf[2] & 0x10) ? SDL_PRESSED : SDL_RELEASED);  /* Start */
+    SDL_PrivateJoystickButton(joystick, 8, (buf[3] & 0x04) ? SDL_PRESSED : SDL_RELEASED);  /* Guide */
+    SDL_PrivateJoystickButton(joystick, 9, (buf[2] & 0x40) ? SDL_PRESSED : SDL_RELEASED);  /* L3 */
+    SDL_PrivateJoystickButton(joystick, 10, (buf[2] & 0x80) ? SDL_PRESSED : SDL_RELEASED); /* R3 */
+
+    /* Terjemahkan analog stick dan trigger (sumbu Y dibalik sesuai konvensi SDL) */
+    {
+        Sint16 lx = (Sint16)((Uint16)buf[6] | ((Uint16)buf[7] << 8));
+        Sint16 ly = (Sint16)((Uint16)buf[8] | ((Uint16)buf[9] << 8));
+        Sint16 rx = (Sint16)((Uint16)buf[10] | ((Uint16)buf[11] << 8));
+        Sint16 ry = (Sint16)((Uint16)buf[12] | ((Uint16)buf[13] << 8));
+        Sint16 lt = (Sint16)(((int)buf[4] * 257) - 32768);
+        Sint16 rt = (Sint16)(((int)buf[5] * 257) - 32768);
+
+        SDL_PrivateJoystickAxis(joystick, 0, lx);
+        SDL_PrivateJoystickAxis(joystick, 1, (Sint16)(-(int)ly - 1));
+        SDL_PrivateJoystickAxis(joystick, 2, lt);
+        SDL_PrivateJoystickAxis(joystick, 3, rx);
+        SDL_PrivateJoystickAxis(joystick, 4, (Sint16)(-(int)ry - 1));
+        SDL_PrivateJoystickAxis(joystick, 5, rt);
+    }
+}
+
+static void IOUSBXINPUT_JoystickClose(SDL_Joystick *joystick)
+{
+    struct joystick_hwdata *hw = joystick->hwdata;
+    if (!hw) {
+        return;
+    }
+
+    joystick->hwdata = NULL;
+    if (hw->item) {
+        hw->item->hwdata = NULL;
+        hw->item = NULL;
+    }
+
+    hw->stop_thread = 1;
+    if (hw->intf && hw->in_pipe) {
+        (*hw->intf)->AbortPipe(hw->intf, hw->in_pipe);
+    }
+    if (hw->thread_started) {
+        pthread_join(hw->thread, NULL);
+        hw->thread_started = 0;
+    }
+    if (hw->intf) {
+        (*hw->intf)->USBInterfaceClose(hw->intf);
+        (*hw->intf)->Release(hw->intf);
+        hw->intf = NULL;
+    }
+    pthread_mutex_destroy(&hw->lock);
+    SDL_free(hw);
+}
+
+static void IOUSBXINPUT_JoystickQuit(void)
+{
+    while (g_devices) {
+        iousb_xinput_device *next = g_devices->next;
+        lepas_item(g_devices);
+        g_devices = next;
+    }
+
+    if (g_added_iter != IO_OBJECT_NULL) {
+        IOObjectRelease(g_added_iter);
+        g_added_iter = IO_OBJECT_NULL;
+    }
+    if (g_terminated_iter != IO_OBJECT_NULL) {
+        IOObjectRelease(g_terminated_iter);
+        g_terminated_iter = IO_OBJECT_NULL;
+    }
+    if (g_notif_port) {
+        IONotificationPortDestroy(g_notif_port);
+        g_notif_port = NULL;
+    }
+    g_initialized = SDL_FALSE;
+}
