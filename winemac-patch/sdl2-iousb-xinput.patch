+/*
+  Driver SDL2 macOS untuk gamepad USB XInput (0xFF/0x5D/0x01) melalui IOKit IOUSBLib.
+  Digunakan agar dongle/kontroler XInput (seperti 8BitDo Ultimate 2C Wireless) terbaca oleh
+  Wine (winebus SDL bus) tanpa perlu kext/driver pihak ketiga.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_JOYSTICK_IOKIT
+
+#include "SDL_events.h"
+#include "SDL_joystick.h"
+#include "SDL_timer.h"
+#include "../SDL_sysjoystick.h"
+#include "../SDL_joystick_c.h"
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOCFPlugIn.h>
+#include <IOKit/IOKitLib.h>
+#include <IOKit/IOMessage.h>
+#include <IOKit/usb/IOUSBLib.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#ifndef kIOMainPortDefault
+#define kIOMainPortDefault kIOMasterPortDefault
+#endif
+
+typedef struct iousb_xinput_device
+{
+    uint64_t registry_id;
+    uint32_t location_id;
+    uint16_t vendor_id;
+    uint16_t product_id;
+    uint16_t bcd_device;
+    int player_index;
+    char *name;
+    char path[64];
+    SDL_JoystickGUID guid;
+    SDL_JoystickID instance_id;
+    io_service_t service;
+    io_object_t termination_notif;
+    SDL_bool removed;
+    struct joystick_hwdata *hwdata;
+    struct iousb_xinput_device *next;
+} iousb_xinput_device;
+
+struct joystick_hwdata
+{
+    iousb_xinput_device *item;
+    IOUSBInterfaceInterface190 **intf;
+    uint8_t in_pipe;
+    uint8_t out_pipe;
+    uint16_t in_max_packet;
+    pthread_t thread;
+    pthread_mutex_t lock;
+    int thread_started;
+    volatile int stop_thread;
+    SDL_bool removed;
+    SDL_bool has_report;
+    SDL_bool axes_zero_set;
+    uint8_t report[64];
+    uint32_t report_len;
+};
+
+static IONotificationPortRef g_notif_port = NULL;
+static io_iterator_t g_added_iter = IO_OBJECT_NULL;
+static io_iterator_t g_terminated_iter = IO_OBJECT_NULL;
+static iousb_xinput_device *g_devices = NULL;
+static SDL_bool g_initialized = SDL_FALSE;
+
+/* Ambil properti bilangan bulat langsung dari objek IOKit */
+static int ambil_int_self(io_registry_entry_t entry, CFStringRef key, int *out)
+{
+    CFTypeRef ref = IORegistryEntryCreateCFProperty(entry, key, kCFAllocatorDefault, 0);
+    int ok = 0;
+    if (!ref) {
+        return 0;
+    }
+    if (CFGetTypeID(ref) == CFNumberGetTypeID()) {
+        ok = CFNumberGetValue((CFNumberRef)ref, kCFNumberIntType, out);
+    }
+    CFRelease(ref);
+    return ok;
+}
+
+/* Cari properti bilangan bulat pada entry atau induk USB-nya */
+static int ambil_int_parent(io_registry_entry_t entry, CFStringRef key, int *out)
+{
+    CFTypeRef ref = IORegistryEntrySearchCFProperty(
+        entry, kIOServicePlane, key, kCFAllocatorDefault,
+        kIORegistryIterateParents | kIORegistryIterateRecursively);
+    int ok = 0;
+    if (!ref) {
+        return 0;
+    }
+    if (CFGetTypeID(ref) == CFNumberGetTypeID()) {
+        ok = CFNumberGetValue((CFNumberRef)ref, kCFNumberIntType, out);
+    }
+    CFRelease(ref);
+    return ok;
+}
+
+/* Cari properti string UTF-8 pada entry atau induk USB-nya */
+static void ambil_str_parent(io_registry_entry_t entry, CFStringRef key, char *buf, size_t cap)
+{
+    CFTypeRef ref;
+    buf[0] = '\0';
+    ref = IORegistryEntrySearchCFProperty(
+        entry, kIOServicePlane, key, kCFAllocatorDefault,
+        kIORegistryIterateParents | kIORegistryIterateRecursively);
+    if (!ref) {
+        return;
+    }
+    if (CFGetTypeID(ref) == CFStringGetTypeID()) {
+        CFStringGetCString((CFStringRef)ref, buf, (CFIndex)cap, kCFStringEncodingUTF8);
+    }
+    CFRelease(ref);
+}
+
+/* Cek apakah antarmuka USB memakai protokol Xbox 360 XInput (0xFF/0x5D/0x01) */
+static SDL_bool apakah_xinput_interface(io_service_t service)
+{
+    int cls = -1, sub = -1, proto = -1;
+    ambil_int_self(service, CFSTR(kUSBInterfaceClass), &cls);
+    ambil_int_self(service, CFSTR(kUSBInterfaceSubClass), &sub);
+    ambil_int_self(service, CFSTR(kUSBInterfaceProtocol), &proto);
+    return (cls == 0xFF && sub == 0x5D && proto == 0x01) ? SDL_TRUE : SDL_FALSE;
+}
+
+static void lepas_item(iousb_xinput_device *item)
+{
+    if (!item) {
+        return;
+    }
+    if (item->hwdata) {
+        item->hwdata->item = NULL;
+        item->hwdata->removed = SDL_TRUE;
+        item->hwdata = NULL;
+    }
+    if (item->termination_notif != IO_OBJECT_NULL) {
+        IOObjectRelease(item->termination_notif);
+        item->termination_notif = IO_OBJECT_NULL;
+    }
+    if (item->service != IO_OBJECT_NULL) {
+        IOObjectRelease(item->service);
+        item->service = IO_OBJECT_NULL;
+    }
+    SDL_free(item->name);
+    SDL_free(item);
+}
+
+static iousb_xinput_device *dapatkan_item_aktif(int device_index)
+{
+    iousb_xinput_device *cur = g_devices;
+    int idx = 0;
+    while (cur) {
+        if (!cur->removed) {
+            if (idx == device_index) {
+                return cur;
+            }
+            idx++;
+        }
+        cur = cur->next;
+    }
+    return NULL;
+}
+
+static void tambahkan_device_dari_service(io_service_t service)
+{
+    uint64_t reg_id = 0;
+    int vid = 0, pid = 0, ver = 0, loc = 0;
+    char mfg[128], prod[128];
+    iousb_xinput_device *cur;
+    iousb_xinput_device *item;
+    iousb_xinput_device **tail;
+
+    if (!apakah_xinput_interface(service)) {
+        return;
+    }
+
+    if (IORegistryEntryGetRegistryEntryID(service, &reg_id) != KERN_SUCCESS) {
+        return;
+    }
+
+    /* Hindari duplikasi jika perangkat sudah terdaftar dan masih aktif */
+    for (cur = g_devices; cur; cur = cur->next) {
+        if (!cur->removed && cur->registry_id == reg_id) {
+            return;
+        }
+    }
+
+    ambil_int_parent(service, CFSTR(kUSBVendorID), &vid);
+    ambil_int_parent(service, CFSTR(kUSBProductID), &pid);
+    ambil_int_parent(service, CFSTR(kUSBDeviceReleaseNumber), &ver);
+    if (!ambil_int_parent(service, CFSTR("locationID"), &loc)) {
+        loc = (int)(reg_id & 0xffffffffU);
+    }
+
+    ambil_str_parent(service, CFSTR("kUSBVendorString"), mfg, sizeof(mfg));
+    if (!mfg[0]) {
+        ambil_str_parent(service, CFSTR("USB Vendor Name"), mfg, sizeof(mfg));
+    }
+    ambil_str_parent(service, CFSTR("kUSBProductString"), prod, sizeof(prod));
+    if (!prod[0]) {
+        ambil_str_parent(service, CFSTR("USB Product Name"), prod, sizeof(prod));
+    }
+    if (!prod[0]) {
+        SDL_strlcpy(prod, "Xbox 360 Controller", sizeof(prod));
+    }
+
+    item = (iousb_xinput_device *)SDL_calloc(1, sizeof(*item));
+    if (!item) {
+        return;
+    }
+
+    item->registry_id = reg_id;
+    item->location_id = (uint32_t)loc;
+    item->vendor_id = (uint16_t)vid;
+    item->product_id = (uint16_t)pid;
+    item->bcd_device = (uint16_t)ver;
+    item->player_index = -1;
+    item->name = SDL_CreateJoystickName(item->vendor_id, item->product_id, mfg, prod);
+    if (!item->name) {
+        SDL_free(item);
+        return;
+    }
+
+    /* Gunakan penanda driver 'x' agar GUID stabil dan tidak bentrok dengan IOHID */
+    item->guid = SDL_CreateJoystickGUID(
+        SDL_HARDWARE_BUS_USB, item->vendor_id, item->product_id, item->bcd_device,
+        mfg, prod, 'x', 0);
+
+    if (SDL_ShouldIgnoreJoystick(item->name, item->guid)) {
+        SDL_free(item->name);
+        SDL_free(item);
+        return;
+    }
+
+    SDL_snprintf(item->path, sizeof(item->path), "iousbxinput#%08x#%llx",
+                 (unsigned)item->location_id, (unsigned long long)item->registry_id);
+    IOObjectRetain(service);
+    item->service = service;
+    item->instance_id = SDL_GetNextJoystickInstanceID();
+
+    tail = &g_devices;
+    while (*tail) {
+        tail = &(*tail)->next;
+    }
+    *tail = item;
+
+    SDL_PrivateJoystickAdded(item->instance_id);
+}
+
+static void proses_antrean_hotplug(void)
+{
+    io_service_t service;
+
+    /* Proses pencabutan perangkat lebih dahulu sebelum penambahan */
+    if (g_terminated_iter != IO_OBJECT_NULL) {
+        while ((service = IOIteratorNext(g_terminated_iter)) != IO_OBJECT_NULL) {
+            uint64_t reg_id = 0;
+            if (IORegistryEntryGetRegistryEntryID(service, &reg_id) == KERN_SUCCESS) {
+                iousb_xinput_device *cur;
+                for (cur = g_devices; cur; cur = cur->next) {
+                    if (!cur->removed && cur->registry_id == reg_id) {
+                        SDL_JoystickID removed_id = cur->instance_id;
+                        cur->removed = SDL_TRUE;
+                        if (cur->hwdata) {
+                            pthread_mutex_lock(&cur->hwdata->lock);
+                            cur->hwdata->removed = SDL_TRUE;
+                            cur->hwdata->item = NULL;
+                            pthread_mutex_unlock(&cur->hwdata->lock);
+                            cur->hwdata = NULL;
+                        }
+                        SDL_PrivateJoystickRemoved(removed_id);
+                    }
+                }
+            }
+            IOObjectRelease(service);
+        }
+    }
+
+    if (g_added_iter != IO_OBJECT_NULL) {
+        while ((service = IOIteratorNext(g_added_iter)) != IO_OBJECT_NULL) {
+            tambahkan_device_dari_service(service);
+            IOObjectRelease(service);
+        }
+    }
+}
+
+/* Callback dummy IOKit; antrean iterator dikuras secara sinkron di Init/Detect tanpa butuh CFRunLoop */
+static void on_iokit_notif(void *refcon, io_iterator_t iterator)
+{
+    (void)refcon;
+    (void)iterator;
+}
+
+static int IOUSBXINPUT_JoystickInit(void)
+{
+    CFMutableDictionaryRef matching_add;
+    CFMutableDictionaryRef matching_rem;
+    kern_return_t kr;
+
+    if (g_initialized) {
+        return 0;
+    }
+
+    g_notif_port = IONotificationPortCreate(kIOMainPortDefault);
+    if (!g_notif_port) {
+        return SDL_SetError("Gagal membuat IONotificationPort untuk USB XInput");
+    }
+
+    matching_add = IOServiceMatching(kIOUSBInterfaceClassName);
+    if (!matching_add) {
+        IONotificationPortDestroy(g_notif_port);
+        g_notif_port = NULL;
+        return SDL_SetError("Gagal membuat kamus matching IOUSBInterface");
+    }
+
+    kr = IOServiceAddMatchingNotification(
+        g_notif_port, kIOFirstMatchNotification, matching_add,
+        on_iokit_notif, NULL, &g_added_iter);
+    if (kr != KERN_SUCCESS) {
+        IONotificationPortDestroy(g_notif_port);
+        g_notif_port = NULL;
+        return SDL_SetError("Gagal mendaftarkan notifikasi tambah IOUSBInterface (0x%x)", kr);
+    }
+
+    matching_rem = IOServiceMatching(kIOUSBInterfaceClassName);
+    if (matching_rem) {
+        if (IOServiceAddMatchingNotification(
+                g_notif_port, kIOTerminatedNotification, matching_rem,
+                on_iokit_notif, NULL, &g_terminated_iter) != KERN_SUCCESS) {
+            g_terminated_iter = IO_OBJECT_NULL;
+        }
+    }
+
+    g_initialized = SDL_TRUE;
+    proses_antrean_hotplug();
+    return 0;
+}
+
+static int IOUSBXINPUT_JoystickGetCount(void)
+{
+    iousb_xinput_device *cur;
+    int count = 0;
+    for (cur = g_devices; cur; cur = cur->next) {
+        if (!cur->removed) {
+            count++;
+        }
+    }
+    return count;
+}
+
+static void IOUSBXINPUT_JoystickDetect(void)
+{
+    iousb_xinput_device **prev = &g_devices;
+    if (!g_initialized) {
+        return;
+    }
+    proses_antrean_hotplug();
+
+    /* Bersihkan simpul perangkat yang sudah dicabut dari daftar */
+    while (*prev) {
+        iousb_xinput_device *cur = *prev;
+        if (cur->removed) {
+            *prev = cur->next;
+            lepas_item(cur);
+        } else {
+            prev = &cur->next;
+        }
+    }
+}
+
+static const char *IOUSBXINPUT_JoystickGetDeviceName(int device_index)
+{
+    iousb_xinput_device *item = dapatkan_item_aktif(device_index);
+    return item ? item->name : NULL;
+}
+
+static const char *IOUSBXINPUT_JoystickGetDevicePath(int device_index)
+{
+    iousb_xinput_device *item = dapatkan_item_aktif(device_index);
+    return item ? item->path : NULL;
+}
+
+static int IOUSBXINPUT_JoystickGetDeviceSteamVirtualGamepadSlot(int device_index)
+{
+    (void)device_index;
+    return -1;
+}
+
+static int IOUSBXINPUT_JoystickGetDevicePlayerIndex(int device_index)
+{
+    iousb_xinput_device *item = dapatkan_item_aktif(device_index);
+    return item ? item->player_index : -1;
+}
+
+static void kirim_led_pemain(IOUSBInterfaceInterface190 **intf, uint8_t out_pipe, int player_index)
+{
+    uint8_t cmd[3];
+    if (!intf || !out_pipe) {
+        return;
+    }
+    cmd[0] = 0x01;
+    cmd[1] = 0x03;
+    cmd[2] = (uint8_t)(0x06 + (player_index >= 0 ? (player_index % 4) : 0));
+    (*intf)->WritePipe(intf, out_pipe, cmd, sizeof(cmd));
+}
+
+static void IOUSBXINPUT_JoystickSetDevicePlayerIndex(int device_index, int player_index)
+{
+    iousb_xinput_device *item = dapatkan_item_aktif(device_index);
+    if (!item) {
+        return;
+    }
+    item->player_index = player_index;
+    if (item->hwdata && item->hwdata->intf && item->hwdata->out_pipe) {
+        kirim_led_pemain(item->hwdata->intf, item->hwdata->out_pipe, player_index);
+    }
+}
+
+static SDL_JoystickGUID IOUSBXINPUT_JoystickGetDeviceGUID(int device_index)
+{
+    iousb_xinput_device *item = dapatkan_item_aktif(device_index);
+    if (!item) {
+        SDL_JoystickGUID empty;
+        SDL_zero(empty);
+        return empty;
+    }
+    return item->guid;
+}
+
+static SDL_JoystickID IOUSBXINPUT_JoystickGetDeviceInstanceID(int device_index)
+{
+    iousb_xinput_device *item = dapatkan_item_aktif(device_index);
+    return item ? item->instance_id : 0;
+}
+
+/* Thread pembaca laporan interrupt USB secara blokir agar loop SDL tidak macet */
+static void *reader_thread_fn(void *arg)
+{
+    struct joystick_hwdata *hw = (struct joystick_hwdata *)arg;
+    uint8_t buf[64];
+
+    while (!hw->stop_thread) {
+        UInt32 size = hw->in_max_packet;
+        IOReturn kr;
+        if (size == 0 || size > sizeof(buf)) {
+            size = sizeof(buf);
+        }
+        kr = (*hw->intf)->ReadPipe(hw->intf, hw->in_pipe, buf, &size);
+        if (hw->stop_thread) {
+            break;
+        }
+        if (kr == kIOReturnSuccess) {
+            if (size >= 20 && buf[0] == 0x00) {
+                pthread_mutex_lock(&hw->lock);
+                memcpy(hw->report, buf, size);
+                hw->report_len = size;
+                hw->has_report = SDL_TRUE;
+                pthread_mutex_unlock(&hw->lock);
+            }
+        } else if (kr == kIOReturnAborted || kr == kIOReturnNoDevice || kr == kIOReturnNotResponding || kr == kIOReturnNotOpen) {
+            pthread_mutex_lock(&hw->lock);
+            hw->removed = SDL_TRUE;
+            pthread_mutex_unlock(&hw->lock);
+            break;
+        } else {
+            /* Hindari pemakaian CPU 100% jika terjadi error sementara */
+            usleep(5000);
+        }
+    }
+    return NULL;
+}
+
+static int IOUSBXINPUT_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    iousb_xinput_device *item = dapatkan_item_aktif(device_index);
+    IOCFPlugInInterface **plug = NULL;
+    IOUSBInterfaceInterface190 **intf = NULL;
+    SInt32 score = 0;
+    kern_return_t kr;
+    HRESULT hr;
+    IOReturn ur;
+    UInt8 num_endpoints = 0;
+    UInt8 in_pipe = 0, out_pipe = 0;
+    UInt16 in_max = 0;
+    struct joystick_hwdata *hw;
+
+    if (!item || item->service == IO_OBJECT_NULL) {
+        return SDL_SetError("Perangkat USB XInput tidak tersedia");
+    }
+
+    kr = IOCreatePlugInInterfaceForService(
+        item->service, kIOUSBInterfaceUserClientTypeID, kIOCFPlugInInterfaceID, &plug, &score);
+    if (kr != kIOReturnSuccess || !plug) {
+        return SDL_SetError("Gagal membuat IOCFPlugIn untuk USB XInput (0x%x)", kr);
+    }
+
+    hr = (*plug)->QueryInterface(
+        plug, CFUUIDGetUUIDBytes(kIOUSBInterfaceInterfaceID190), (LPVOID *)&intf);
+    (*plug)->Release(plug);
+    if (hr != S_OK || !intf) {
+        return SDL_SetError("Gagal memperoleh IOUSBInterfaceInterface190 (0x%x)", (unsigned)hr);
+    }
+
+    ur = (*intf)->USBInterfaceOpen(intf);
+    if (ur != kIOReturnSuccess) {
+        (*intf)->Release(intf);
+        return SDL_SetError("Gagal membuka antarmuka USB XInput secara eksklusif (0x%x)", ur);
+    }
+
+    if ((*intf)->GetNumEndpoints(intf, &num_endpoints) != kIOReturnSuccess) {
+        (*intf)->USBInterfaceClose(intf);
+        (*intf)->Release(intf);
+        return SDL_SetError("Gagal membaca jumlah endpoint USB XInput");
+    }
+
+    for (UInt8 p = 1; p <= num_endpoints; p++) {
+        UInt8 dir = 0, num = 0, ttype = 0, interval = 0;
+        UInt16 maxpkt = 0;
+        if ((*intf)->GetPipeProperties(intf, p, &dir, &num, &ttype, &maxpkt, &interval) == kIOReturnSuccess) {
+            if (ttype == kUSBInterrupt) {
+                if (dir == kUSBIn && !in_pipe) {
+                    in_pipe = p;
+                    in_max = maxpkt;
+                } else if (dir == kUSBOut && !out_pipe) {
+                    out_pipe = p;
+                }
+            }
+        }
+    }
+
+    if (!in_pipe) {
+        (*intf)->USBInterfaceClose(intf);
+        (*intf)->Release(intf);
+        return SDL_SetError("Endpoint interrupt IN tidak ditemukan pada USB XInput");
+    }
+
+    hw = (struct joystick_hwdata *)SDL_calloc(1, sizeof(*hw));
+    if (!hw) {
+        (*intf)->USBInterfaceClose(intf);
+        (*intf)->Release(intf);
+        return SDL_OutOfMemory();
+    }
+
+    pthread_mutex_init(&hw->lock, NULL);
+    hw->item = item;
+    hw->intf = intf;
+    hw->in_pipe = in_pipe;
+    hw->out_pipe = out_pipe;
+    hw->in_max_packet = in_max;
+
+    joystick->hwdata = hw;
+    joystick->naxes = 6;
+    joystick->nbuttons = 11;
+    joystick->nhats = 1;
+    joystick->epowerlevel = SDL_JOYSTICK_POWER_UNKNOWN;
+
+    item->hwdata = hw;
+    kirim_led_pemain(intf, out_pipe, item->player_index);
+
+    if (pthread_create(&hw->thread, NULL, reader_thread_fn, hw) != 0) {
+        item->hwdata = NULL;
+        joystick->hwdata = NULL;
+        pthread_mutex_destroy(&hw->lock);
+        SDL_free(hw);
+        (*intf)->USBInterfaceClose(intf);
+        (*intf)->Release(intf);
+        return SDL_SetError("Gagal membuat thread pembaca USB XInput");
+    }
+    hw->thread_started = 1;
+
+    return 0;
+}
+
+static int IOUSBXINPUT_JoystickRumble(SDL_Joystick *joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+    struct joystick_hwdata *hw = joystick->hwdata;
+    uint8_t packet[8];
+    IOReturn kr;
+
+    if (!hw || hw->removed || !hw->intf) {
+        return SDL_SetError("Getar gagal: perangkat tidak terhubung");
+    }
+    if (!hw->out_pipe) {
+        return SDL_Unsupported();
+    }
+
+    SDL_zeroa(packet);
+    packet[0] = 0x00;
+    packet[1] = 0x08;
+    packet[2] = 0x00;
+    packet[3] = (uint8_t)(low_frequency_rumble >> 8);
+    packet[4] = (uint8_t)(high_frequency_rumble >> 8);
+
+    kr = (*hw->intf)->WritePipe(hw->intf, hw->out_pipe, packet, sizeof(packet));
+    if (kr != kIOReturnSuccess) {
+        return SDL_SetError("Gagal mengirim paket getar USB (0x%x)", kr);
+    }
+    return 0;
+}
