diff --git a/dlls/d3dx9_36/shader.c b/dlls/d3dx9_36/shader.c
--- a/dlls/d3dx9_36/shader.c
+++ b/dlls/d3dx9_36/shader.c
@@ -3013,4 +3013,64 @@
     TRACE("byte_code %p, semantics %p, count %p.\n", byte_code, semantics, count);
 
     return get_shader_semantics(byte_code, semantics, count, TRUE);
+}
+
+#if D3DX_SDK_VERSION <= 41
+/* d3dx9_42 dropped the fragment linker's gather functions. The linker's own methods are
+ * stubs, so fail here instead of aborting in a spec stub. */
+static HRESULT gather_fragments_stub(ID3DXBuffer **fragments, ID3DXBuffer **errors)
+{
+    if (fragments)
+        *fragments = NULL;
+    if (errors)
+        *errors = NULL;
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI D3DXGatherFragments(const char *data, UINT data_len, const D3DXMACRO *defines,
+        ID3DXInclude *include, DWORD flags, ID3DXBuffer **fragments, ID3DXBuffer **errors)
+{
+    FIXME("data %p, data_len %u, defines %p, include %p, flags %#lx, fragments %p, errors %p stub!\n",
+            data, data_len, defines, include, flags, fragments, errors);
+
+    return gather_fragments_stub(fragments, errors);
+}
+
+HRESULT WINAPI D3DXGatherFragmentsFromFileA(const char *filename, const D3DXMACRO *defines,
+        ID3DXInclude *include, DWORD flags, ID3DXBuffer **fragments, ID3DXBuffer **errors)
+{
+    FIXME("filename %s, defines %p, include %p, flags %#lx, fragments %p, errors %p stub!\n",
+            debugstr_a(filename), defines, include, flags, fragments, errors);
+
+    return gather_fragments_stub(fragments, errors);
+}
+
+HRESULT WINAPI D3DXGatherFragmentsFromFileW(const WCHAR *filename, const D3DXMACRO *defines,
+        ID3DXInclude *include, DWORD flags, ID3DXBuffer **fragments, ID3DXBuffer **errors)
+{
+    FIXME("filename %s, defines %p, include %p, flags %#lx, fragments %p, errors %p stub!\n",
+            debugstr_w(filename), defines, include, flags, fragments, errors);
+
+    return gather_fragments_stub(fragments, errors);
 }
+
+HRESULT WINAPI D3DXGatherFragmentsFromResourceA(HMODULE module, const char *resource,
+        const D3DXMACRO *defines, ID3DXInclude *include, DWORD flags, ID3DXBuffer **fragments,
+        ID3DXBuffer **errors)
+{
+    FIXME("module %p, resource %s, defines %p, include %p, flags %#lx, fragments %p, errors %p stub!\n",
+            module, debugstr_a(resource), defines, include, flags, fragments, errors);
+
+    return gather_fragments_stub(fragments, errors);
+}
+
+HRESULT WINAPI D3DXGatherFragmentsFromResourceW(HMODULE module, const WCHAR *resource,
+        const D3DXMACRO *defines, ID3DXInclude *include, DWORD flags, ID3DXBuffer **fragments,
+        ID3DXBuffer **errors)
+{
+    FIXME("module %p, resource %s, defines %p, include %p, flags %#lx, fragments %p, errors %p stub!\n",
+            module, debugstr_w(resource), defines, include, flags, fragments, errors);
+
+    return gather_fragments_stub(fragments, errors);
+}
+#endif
