+
+static BOOL winmm_init_active(void)
+{
+    BOOL active = FALSE;
+
+    EnterCriticalSection(&g_dev_lock);
+    if (g_winmm_init_until)
+    {
+        if ((LONGLONG)(GetTickCount64() - g_winmm_init_until) < 0)
+            active = TRUE;
+        else
+        {
+            g_winmm_init_until = 0;
+            g_winmm_init_tid = 0;
+        }
+    }
+    LeaveCriticalSection(&g_dev_lock);
+    return active;
+}
 
