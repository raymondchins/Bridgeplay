+static void set_device_state(MMDevice *dev, DWORD state)
+{
+    WCHAR guidstr[39];
+    HKEY key;
+
+    StringFromGUID2(&dev->devguid, guidstr, ARRAY_SIZE(guidstr));
+    if (RegCreateKeyExW(dev->flow == eRender ? key_render : key_capture, guidstr, 0, NULL, 0,
+            KEY_WRITE | KEY_READ | KEY_WOW64_64KEY, NULL, &key, NULL) == ERROR_SUCCESS)
+    {
+        RegSetValueExW(key, L"DeviceState", 0, REG_DWORD, (const BYTE *)&state, sizeof(DWORD));
+        RegCloseKey(key);
+    }
+    dev->state = state;
+}
+
+static BOOL is_active_override(const WCHAR *name)
+{
+    IMMDevice *dev;
+    DWORD state;
+    BOOL active = FALSE;
+
+    if (!name[0])
+        return FALSE;
+    if (SUCCEEDED(IMMDeviceEnumerator_GetDevice(&enumerator.IMMDeviceEnumerator_iface, name, &dev)))
+    {
+        if (SUCCEEDED(IMMDevice_GetState(dev, &state)) && state == DEVICE_STATE_ACTIVE)
+            active = TRUE;
+        IMMDevice_Release(dev);
+    }
+    return active;
+}
