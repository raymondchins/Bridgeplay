+/* The host's default device can change while a process runs (headphones connected, another
+ * output picked in the system's sound settings), and the driver reports it only when asked.
+ * Returns TRUE when the driver's default for flow is no longer MMDevice_def_play or
+ * MMDevice_def_rec, after making it so. */
+static BOOL refresh_system_default(EDataFlow flow)
+{
+    struct get_endpoint_ids_params params;
+    MMDevice **def = flow == eRender ? &MMDevice_def_play : &MMDevice_def_rec;
+    MMDevice *dev, *found = NULL;
+    BOOL changed = FALSE;
+    GUID guid;
+
+    params.flow = flow;
+    params.size = 1024;
+    params.endpoints = NULL;
+    do {
+        free(params.endpoints);
+        if (!(params.endpoints = malloc(params.size)))
+            return FALSE;
+        __wine_unix_call(drvs.module_unixlib, get_endpoint_ids, &params);
+    } while (params.result == HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER));
+
+    if (SUCCEEDED(params.result) && params.default_idx < params.num)
+    {
+        const struct endpoint *ep = &params.endpoints[params.default_idx];
+        const WCHAR *name = (WCHAR *)((char *)params.endpoints + ep->name);
+        const char *dev_name = (char *)params.endpoints + ep->device;
+
+        get_device_guid(flow, dev_name, &guid);
+        if (!*def || !IsEqualGUID(&(*def)->devguid, &guid))
+        {
+            LIST_FOR_EACH_ENTRY(dev, &device_list, MMDevice, entry)
+            {
+                if (dev->flow == flow && IsEqualGUID(&dev->devguid, &guid))
+                {
+                    found = dev;
+                    break;
+                }
+            }
+            if (found && found->state == DEVICE_STATE_ACTIVE)
+                *def = found;
+            /* CEILING: device_list has no lock of its own, so a device first seen here is
+             * added while another thread may be walking the list. It is rare (once per new
+             * device); a list lock shared with the enumerator is the upgrade path. */
+            else if ((found = MMDevice_Create(name, &guid, flow, DEVICE_STATE_ACTIVE, TRUE)))
+                set_format(found);
+            changed = found != NULL;
+            TRACE("system default %s is now %s\n", flow == eRender ? "output" : "input",
+                    debugstr_w(name));
+        }
+    }
+
+    free(params.endpoints);
+    return changed;
+}
+
+/* Called with g_notif_lock held. A default the user set in the registry wins, as in
+ * MMDevEnum_GetDefaultAudioEndpoint, so only roles that follow the system are notified. */
+static void notify_system_default(EDataFlow flow, const WCHAR *name, const WCHAR *voice_name)
+{
+    MMDevice *def;
+    WCHAR *id;
+
+    if (!refresh_system_default(flow))
+        return;
+
+    def = flow == eRender ? MMDevice_def_play : MMDevice_def_rec;
+    if (FAILED(IMMDevice_GetId(&def->IMMDevice_iface, &id)))
+        return;
+
+    if (!name[0])
+    {
+        notify_clients(flow, eConsole, id);
+        if (!voice_name[0])
+            notify_clients(flow, eCommunications, id);
+    }
+    CoTaskMemFree(id);
+}
